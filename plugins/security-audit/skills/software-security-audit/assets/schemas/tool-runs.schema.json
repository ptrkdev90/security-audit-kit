{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "utc_time": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "failed",
              "unavailable"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "network_use": {
            "type": "string",
            "minLength": 1
          },
          "rules_or_database": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "tool",
          "version",
          "command",
          "target",
          "utc_time",
          "status",
          "exit_code",
          "network_use",
          "rules_or_database",
          "output",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "items"
  ],
  "additionalProperties": false
}
